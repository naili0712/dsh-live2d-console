{
  "name": "dsh-live2d-console",
  "version": "0.1.0",
  "private": false,
  "description": "dshlive2d控制台：Live2D 桌宠与 DSH 会话之间的桥，并在 DSH 设置页里提供跟随启停的总控开关。",
  "meta": {
    "title": "dshlive2d控制台",
    "description": "Live2D 桌宠的会话桥与跟随启停开关。"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "install.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "live2d"
  ],
  "license": "PolyForm-Noncommercial-1.0.0"
}
